# cf. .pipeline/blubber.yaml

FROM docker-registry.wikimedia.org/nodejs24-slim

RUN apt-get update && \
	apt-get install -y \
		ca-certificates \
		build-essential \
		python3 \
		pkg-config \
		git

ARG UID=1000
ARG GID=1000

RUN groupadd --gid $GID runuser && useradd --uid $UID --gid $GID runuser

USER runuser
